+
+/* ENKA camera: full-width card under the pressure-centres panel. */
+.dashboard-top{
+  grid-template-columns:minmax(0,1fr)!important;
+}
+.dashboard-top>.dashboard-left,
+.dashboard-top .station-card{
+  width:100%!important;
+  max-width:none!important;
+  min-width:0!important;
+}
+#enka-kamera{
+  width:100%;
+  max-width:100%;
+  min-width:0;
+}
+#enka-camera-panel.enka-camera-panel{
+  width:100%!important;
+  max-width:100%!important;
+  min-width:0!important;
+  margin:0!important;
+  justify-self:stretch!important;
+  align-self:stretch!important;
+  position:static!important;
+  left:auto!important;
+  transform:none!important;
+  grid-column:auto!important;
+  border:1px solid var(--line);
+  border-radius:21px;
+  background:linear-gradient(145deg,rgba(18,43,61,.94),rgba(12,31,46,.96));
+  overflow:hidden;
+  box-sizing:border-box;
+}
+#enka-camera-panel .enka-camera-head,
+#enka-camera-panel .enka-camera-foot{
+  display:flex;
+  align-items:center;
+  justify-content:space-between;
+  gap:10px 12px;
+  flex-wrap:wrap;
+  min-width:0;
+}
+#enka-camera-panel .enka-camera-title,
+#enka-camera-panel .enka-camera-status,
+#enka-camera-panel .enka-camera-foot span{
+  min-width:0;
+  white-space:normal;
+  overflow-wrap:anywhere;
+}
+#enka-camera-panel .enka-camera-status{text-align:right}
+#enka-camera-panel .enka-camera-stage{
+  position:relative;
+  width:100%;
+  max-width:100%;
+  aspect-ratio:16/9;
+  background:#071521;
+  overflow:hidden;
+}
+@supports not (aspect-ratio: 16 / 9){
+  #enka-camera-panel .enka-camera-stage{height:0;padding-top:56.25%}
+}
+#enka-camera-panel .enka-camera-frame,
+#enka-camera-panel .enka-camera-placeholder{
+  position:absolute;
+  inset:0;
+  width:100%!important;
+  height:100%!important;
+  max-width:100%;
+  min-height:0!important;
+}
+#enka-camera-panel .enka-camera-frame{
+  object-fit:cover;
+  aspect-ratio:auto;
+}
+#enka-camera-panel .enka-camera-frame.is-pending,
+#enka-camera-image:not([src]){visibility:hidden}
+#enka-camera-panel .enka-camera-placeholder{
+  display:grid;
+  place-items:center;
+  padding:16px;
+  text-align:center;
+  color:#9fb4c0;
+  font-size:13px;
+  line-height:1.45;
+  background:
+    linear-gradient(180deg,rgba(8,24,36,.15),rgba(8,24,36,.62)),
+    repeating-linear-gradient(135deg,rgba(125,211,215,.06) 0 12px,transparent 12px 24px);
+}
+#enka-camera-panel .enka-camera-placeholder[hidden]{display:none!important}
+html.ios12 #enka-camera-panel,
+html.ios12 #enka-camera-panel .enka-camera-stage,
+html.ios12 #enka-camera-panel .enka-camera-frame{
+  width:100%!important;
+  max-width:100%!important;
+  min-width:0!important;
+}
+html.ios12 #enka-camera-panel .enka-camera-frame{
+  position:absolute!important;
+  height:100%!important;
+  min-height:0!important;
+}
+@media(max-width:700px){
+  #enka-camera-panel.enka-camera-panel{
+    width:100%!important;
+    max-width:100%!important;
+    margin:0!important;
+  }
+}
